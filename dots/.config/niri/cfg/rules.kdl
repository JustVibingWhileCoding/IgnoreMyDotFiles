//--General------------------------------------------------------------------------------------------------------------------
    
    window-rule {
        geometry-corner-radius 10 // Set every window radius to 10
        clip-to-geometry true

        draw-border-with-background false

        shadow {
            on // Turns shadows on globally for windows
            softness 15 
            spread 2 
            offset x=0 y=0 
            color "rgba(0, 0, 0, 0.5)" 
            draw-behind-window false
        }
    }

    window-rule {
        background-effect {
          blur false
          xray false
        }
    }

    debug {
        // Fixes the frame pacing and micro-stutters in fullscreen games
        disable-direct-scanout true
    }


//--Apps---------------------------------------------------------------------------------------------------------------------

    window-rule {

        match app-id="^zen$"
        match app-id="^zen-twilight$"
        match app-id="^kitty$"

        background-effect {
          blur true
          xray false
        }
    }

    window-rule {
        match app-id="^code$"
    
        opacity 0.9

        background-effect {
            blur true
            xray false // Makes sure it blurs other windows behind it, not just the wallpaper
        }
    }

    

    // if you use steam you will probably like these
    window-rule {
        match app-id="steam"
        exclude title=r#"^[Ss]team$"#
        open-floating true
    }

    window-rule {
       match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
       default-floating-position x=10 y=10 relative-to="bottom-right"
       open-focused false
    }

    // Open the Firefox picture-in-picture player as floating by default.
    window-rule {
    
        match title="^Picture-in-Picture$"

        open-floating true

        default-column-width { proportion 0.23; }
        default-window-height { proportion 0.241; }

        // Snaps the window to the bottom-right corner of the screen.
        default-floating-position x=10 y=10 relative-to="bottom-right"
    }

    // Floating Heroic launcher.
    window-rule {
        match app-id="heroic"
        
        open-floating true
        
        default-column-width { proportion 0.85; }
        default-window-height { proportion 0.85; }
    }

    
//--Noctalia-----------------------------------------------------------------------------------------------------------------

    // Floating Noctalia settings window.
    window-rule {
        match app-id="dev.noctalia.Noctalia"
        
        open-floating true
        
        default-column-width { fixed 1080; }
        default-window-height { fixed 920; }
    }

    //Disable xray on all our surfaces so it looks more realistic.
    layer-rule {
        match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
        
        background-effect {
          xray false
          // blur false
        }
    }


//--Overview-----------------------------------------------------------------------------------------------------------------

    //Overview background blur effect + workspace background
    layer-rule {
        match namespace="^noctalia-backdrop"
        place-within-backdrop true
    }

    // 1. Keep this one! This allows the blurred/overview canvas to sit in the backdrop
    layer-rule {
        match namespace="^noctalia-overview*"
        place-within-backdrop true
    }